

# --- Postgres ---
POSTGRES_USER=contextos
POSTGRES_PASSWORD=contextos
POSTGRES_DB=contextos
DATABASE_URL=postgresql+psycopg://contextos:contextos@postgres:5432/contextos

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Neo4j (stub -- see backend/app/graph.py) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_AUTH=neo4j/changeme

# --- LLM provider ---
# "gemini" (default), "anthropic", or "openai"
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
# Update if this model id is retired -- see README for notes.
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
# Comma-separated allowed origins for the backend API. "*" is fine for local
# dev with the Chrome extension; tighten this if you deploy the backend
# anywhere reachable beyond localhost.
CORS_ALLOWED_ORIGINS=*

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
