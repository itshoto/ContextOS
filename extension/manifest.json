{
  "manifest_version": 3,
  "name": "ContextOS",
  "description": "AI personal-knowledge-system: index the page you're looking at, then ask grounded questions over everything you've indexed.",
  "version": "0.0.1",
  "action": {
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*"]
}
